/* Sawmill base stylesheet — Nord transparent theme
 * Derived from STYLE_SPEC.md
 */

/* === 4.1 Screen === */
Screen {
    background: transparent;
}

/* === 4.2 Scrollbars (global) === */
* {
    scrollbar-size: 0 0;
}

/* === 4.3 Panel (bordered container with focus) === */
.panel {
    background: transparent;
    border: round $primary-background-lighten-3;
    border-title-color: $primary;
    border-title-background: transparent;
    border-subtitle-color: $text-muted;
    border-subtitle-background: transparent;
    opacity: 1 !important;
    background-tint: transparent !important;
}

.panel:focus-within {
    border: round $primary-lighten-3;
}

/* === Header === */
#header {
    height: auto;
    background: transparent;
    color: $text;
    width: 100%;
    padding: 0 1;
    border-bottom: solid $primary-background-lighten-3;
}

#header-brand {
    width: auto;
    height: 1;
    text-align: left;
    text-style: bold;
    padding: 0 1 0 0;
}

.header-tab {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.header-tab.active-tab {
    color: $text;
    text-style: reverse;
}

#header-right {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text-muted;
}

/* === Severity panel === */
#severity-panel {
    height: auto;
}

/* === Severity stats bar === */
#severity-bar {
    height: 1;
    background: transparent;
    padding: 0 1;
    width: 100%;
}

/* === 4.4 Custom Footer === */
.footer {
    dock: bottom;
    height: 1;
    background: transparent;
}

.footer > * {
    background: transparent;
}

.footer-key {
    color: $primary;
    text-style: bold;
    width: auto;
}

.footer-label {
    color: $text;
    width: auto;
    padding: 0 1 0 0;
}

/* === 4.7 Input Fields === */
Input {
    padding: 0 1;
    height: 1;
    border: none;
    background: transparent;
    color: $text;
}

Input > .input--placeholder {
    color: $text-muted;
}

Input:focus {
    border: none;
}

/* === Search panel === */
#search-panel {
    height: auto;
    max-height: 3;
}

/* === Messages panel (main content) === */
#messages-panel {
    height: 1fr;
}

/* === 4.8 DataTable === */
DataTable {
    background: transparent;
    opacity: 1 !important;
    background-tint: transparent !important;
    width: 100%;
    overflow-x: hidden;
}

DataTable > .datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--header-cell {
    background: transparent;
    color: $primary;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
}

DataTable > .datatable--hover {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: transparent;
}

DataTable > .datatable--even-row {
    background: $background-lighten-1;
}

/* === Detail panel === */
#detail-panel {
    height: auto;
    min-height: 3;
    max-height: 12;
}

#detail-content {
    background: transparent;
    padding: 0 1;
}

/* === 4.6 Buttons === */
.btn {
    background: transparent;
    border: round $primary-background-lighten-3;
    color: $text;
    text-style: none;
}

.btn:hover {
    background: transparent;
    border: round $primary-lighten-3;
    color: $primary;
}

.btn:focus {
    background: transparent;
    border: round $primary;
    color: $primary;
    text-style: bold;
}

.btn.-disabled, .btn:disabled {
    color: $text-muted;
    border: round $primary-background-lighten-3;
    text-style: none;
}

/* Semantic button variants */
.btn-danger:hover, .btn-danger:focus {
    border: round $error;
    color: $error;
}

.btn-success:hover, .btn-success:focus {
    border: round $success;
    color: $success;
}

.btn-warning:hover, .btn-warning:focus {
    border: round $warning;
    color: $warning;
}

/* === Modals === */
ModalScreen {
    background: transparent;
}

.modal-container {
    background: transparent;
    border: round $primary;
    border-title-color: $primary;
    border-title-background: transparent;
    padding: 1 2;
    opacity: 1 !important;
    background-tint: transparent !important;
}

.modal-title {
    text-style: bold;
    color: $primary;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

.modal-footer {
    margin-top: 1;
    height: auto;
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

.modal-key {
    color: $primary;
    text-style: bold;
}

/* === Content match toggle buttons === */
#waive-content-match {
    height: auto;
    width: auto;
}

.content-match-btn {
    background: transparent;
    border: round $primary-background-lighten-3;
    color: $text-muted;
    text-style: none;
    min-width: 14;
}

.content-match-btn.content-match-selected {
    border: round $primary;
    color: $text;
    text-style: bold;
}

.content-match-btn:focus {
    border: round $primary-lighten-3;
    color: $primary-lighten-3;
}

.content-match-btn.-active {
    background: transparent;
    tint: transparent;
    border: round $primary-lighten-3;
}

/* === Toast notifications === */
Toast {
    background: transparent;
    border: round $primary-background-lighten-3;
    opacity: 1 !important;
    background-tint: transparent !important;
}

Toast.-information {
    border: round $primary;
}

Toast.-warning {
    border: round $warning;
}

Toast.-error {
    border: round $error;
}

.toast--title {
    color: $text;
    text-style: bold;
}

Toast.-information .toast--title {
    color: $primary;
}

Toast.-warning .toast--title {
    color: $warning;
}

Toast.-error .toast--title {
    color: $error;
}

/* === Radio controls === */
RadioSet {
    background: transparent;
    height: auto;
    border: none;
    padding: 0;
    opacity: 1 !important;
    background-tint: transparent !important;
}

RadioSet:focus {
    border: none;
    background-tint: transparent !important;
}

RadioSet:blur > RadioButton.-selected > .toggle--label {
    background: transparent;
}

RadioSet:focus > RadioButton.-selected > .toggle--label {
    background: transparent;
    color: $primary-lighten-3;
    text-style: bold;
}

RadioSet > RadioButton {
    background: transparent;
    border: none;
    padding: 0;
    color: $text;
    opacity: 1 !important;
    background-tint: transparent !important;
}

RadioSet > RadioButton > .toggle--button {
    background: $background;
    color: $text-muted;
}

RadioSet > RadioButton.-on > .toggle--button {
    color: $primary-background-lighten-3;
    background: $background;
}

RadioSet:focus > RadioButton.-on > .toggle--button {
    color: $primary-lighten-3;
}

RadioButton {
    background: transparent;
    color: $text;
    opacity: 1 !important;
    background-tint: transparent !important;
}

RadioButton:focus {
    background-tint: transparent !important;
}

RadioButton:focus > .toggle--label {
    background: transparent;
    color: $primary-lighten-3;
    text-style: bold;
}

RadioButton:blur:hover > .toggle--label {
    background: transparent;
}

RadioButton.-on > .toggle--button {
    color: $primary;
    background: $background;
}

/* === Inputs inside modals === */
.modal-container Input {
    border: round $primary-background-lighten-3;
    background: transparent;
    height: 3;
}

.modal-container Input:focus {
    border: round $primary-lighten-3;
}

/* === 4.9 Utility Classes === */
.hidden { display: none; }
.transparent { background: transparent; }
.center { align: center middle; content-align: center middle; }
