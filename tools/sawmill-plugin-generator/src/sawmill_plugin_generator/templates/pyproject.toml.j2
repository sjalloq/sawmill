[build-system]
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"

[project]
name = "{{ package_name }}"
dynamic = ["version"]
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.10"
license = {text = "MIT"}
authors = [
    {name = "{{ author }}"}
]
keywords = ["sawmill", "plugin", "{{ plugin_name }}", "eda", "log"]

dependencies = [
    "sawmill-parser>=0.2.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "ruff>=0.4.0",
]

[project.entry-points."sawmill.plugins"]
{{ entry_point_key }} = "{{ module_name }}:{{ class_name }}"

[tool.hatch.version]
source = "vcs"

[tool.hatch.build.hooks.vcs]
version-file = "src/{{ module_name }}/_version.py"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ module_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py310"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "RUF"]

[tool.sawmill]
plugin_api = "{{ plugin_api_version }}"
